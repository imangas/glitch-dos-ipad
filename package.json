{
  "name": "glitchlock-dos",
  "version": "0.12.0",
  "private": true,
  "description": "DOS games launcher for any device.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build:css": "tailwindcss -i css/input.css -o css/styles.css --minify",
    "watch:css": "tailwindcss -i css/input.css -o css/styles.css --minify --watch",
    "build": "npm run build:css && node scripts/build.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imangas/glitchlock-dos.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "keywords": [
    "DOS",
    "emulator",
    "js-dos",
    "dosbox"
  ],
  "author": "Nacho Mangas <ignaciomangas@gmail.com>",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/imangas/glitchlock-dos/issues"
  },
  "homepage": "https://imangas.github.io/glitchlock-dos/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.12.0",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2"
  }
}
